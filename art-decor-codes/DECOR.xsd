                    <xforms:label xml:lang="en-US">Maximum length</xforms:label>
                    <xforms:label xml:lang="de-DE">Maximale Länge</xforms:label>
                </xs:appinfo>
                <xs:documentation>max length for strings</xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>
