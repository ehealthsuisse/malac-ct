                    <xs:appinfo>
                        <xforms:label xml:lang="en-US">Info</xforms:label>
                        <xforms:label xml:lang="nl-NL">Info</xforms:label>
                        <xforms:label xml:lang="de-DE">Info</xforms:label>
                    </xs:appinfo>
                </xs:annotation>
